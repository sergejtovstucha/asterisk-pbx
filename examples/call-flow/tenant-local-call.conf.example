; Asterisk Multitenant PBX - internal call flow (illustrative excerpt)
; Derived from the legacy outgoing.conf and local.conf architecture.
; NOT a standalone, deployable, or security-complete dialplan.
; Dependencies: authenticated PJSIP endpoint/context policy, ODBC function definitions,
; existing shared subroutines for local call handling.
;
; In the legacy PBX, outgoing-PREFIX contexts are generated by Web provisioning
; and perform Realtime lookup of tenant-specific extensions.
;
[outgoing-1001]
switch => Realtime/${CONTEXT}@extensions
include => blf-1001

; The following excerpts show the key logical steps in the SHARED [outgoing]
; and [local] modules; omitted legacy validation, recording, limits,
; forwarding and other production features are NOT implemented here.
;
; Shared outgoing flow, excerpt for documentation only
; [outgoing]
; exten => _X!,1,NoOp(Shared outgoing processing)
; same => n,Set(FROM=${PJSIP_HEADER(read,From)})
; same => n,Set(FROM_ACCOUNT=${CUT(CUT(FROM,\:,2),@,1)})
; same => n,Set(PREFIX=${FROM_ACCOUNT:0:4})
; same => n,Set(__ACCOUNT_NAME=${FROM_ACCOUNT})
; same => n,Set(__COMPANY_ID=${ODBC_GET_COMPANY_ID(${PREFIX})})
; same => n,Gosub(local,${EXTEN},1)
;
; Shared local flow, excerpt for documentation only
; [local]
; exten => _X!,1,NoOp(Shared local-call processing)
; same => n,Set(DST_EXTEN=${EXTEN})
; same => n,Set(FROM_ACCOUNT=${ACCOUNT_NAME})
; same => n,Set(LOCAL_ACCOUNT=${PREFIX}*${DST_EXTEN})
; same => n,Gosub(local_exten,s,1(${COMPANY_ID},${PREFIX},${LOCAL_ACCOUNT},${DST_EXTEN},${FROM_ACCOUNT}))
; same => n,Return()
;
; [local_exten] in the original checks ODBC_LOCAL_ACCOUNT_EXIST(${ARG3})
; before forwarding / contact selection and subsequent dialing logic.
;
; SECURITY: FROM is caller-controlled SIP information. In the legacy logic it
; supplied the namespace, but deployment must verify that the authenticated
; PJSIP endpoint is authorized for the supplied prefix. Do not copy this
; snippet into production without that access-control check.
